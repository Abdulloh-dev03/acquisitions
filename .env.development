# Local development configuration for Acquisitions API
# This file is ignored by git (.gitignore has .env.*)

NODE_ENV=development
PORT=4000

# Neon Local connection string (inside the docker-compose.dev network)
# These credentials are dummy; Neon Local uses NEON_API_KEY/NEON_PROJECT_ID for auth
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb

# Neon Cloud credentials for Neon Local to create ephemeral branches
# Get these from your Neon dashboard and DO NOT commit them anywhere
NEON_API_KEY=napi_c5ewfteqvs8kkfu2qjbgv4px70r5rq9mw9cq489sjah57usrt1xwkc74yera36z6
NEON_PROJECT_ID=noisy-butterfly-64997297
PARENT_BRANCH_ID=br-noisy-glade-ahd3bgq9

DELETE_BRANCH=true

#ARCJET
ARCJET_KEY=ajkey_01kd8751m0fz6tg94j27x7cqj0

